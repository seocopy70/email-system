# 로그인 세션 서명용 비밀키 (필수 권장). 긴 무작위 문자열, 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
